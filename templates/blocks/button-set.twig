{%- from "templates/macros/buttons.twig" import button, video -%}
<div
	class="paragraph-widget paragraph-widget--button-set"{% if block.anchor|length > 0 %} id="{{ block.anchor|e('esc_attr') }}"{% endif %}>
	<div class="iastate22-button-set">
		<ul>
			{% for item in fields.buttons %}
				<li>
					{%- if item.video -%}
						{{ video(item.label, item.video) }}
					{%- elseif item.link_url -%}
						{{ button(item.label, item.link_url, item.external) }}
					{%- endif -%}
				</li>
			{% endfor %}
		</ul>
	</div>
</div>
