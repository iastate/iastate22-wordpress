<div class="paragraph-widget paragraph-widget--call-to-action--small {{ block.className|e('esc_attr') }}"
		{%- if block.anchor|length > 0 %} id="{{ block.anchor|e('esc_attr') }}"{%- endif -%}>
	<div class="call-to-action call-to-action--small">
		<div class="call-to-action__copy-wrap">
			{% if fields.callout_content.title %}<h2
					class="call-to-action__headline">{{ fields.callout_content.title }}</h2>{% endif %}
			{% if fields.callout_content.content %}
				<div>{{ fields.callout_content.content }}</div>
			{% endif %}
		</div>
		<div class="iastate22-button-set">
			<ul>
				{% for item in fields.callout_content.callout_ctas %}
					{% if item.link_url %}
						{%- set link_url = item.link_url['url'] -%}
						{%- set link_target = item.link_style == 'external' ? '_blank' :  ( item.link_url['target'] ? item.link_url['target'] : '_self' ) -%}
						<li>
							<a class="iastate22-button" href="{{ is_preview ? '#' : link_url|e('esc_url') }}"
							   target="{{ link_target|e('esc_attr') }}">
								{{ item.label }}<span class="arrow"></span></a>
						</li>
					{% endif %}
				{% endfor %}
			</ul>
		</div>
	</div>
</div>
