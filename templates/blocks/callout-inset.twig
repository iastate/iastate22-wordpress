<div class="paragraph-widget paragraph-widget--callout-inset {{ block.className|e('esc_attr') }}"
		{%- if block.anchor|length > 0 %} id="{{ block.anchor|e('esc_attr') }}"{%- endif -%}>
	<div class="callout-inset">
		<div class="callout-inset_inset">
			<h2 class="callout-inset_inset-headline">{{ fields.callout.title }}</h2>
			<div>{{ fields.callout.content }}</div>
		</div>
		<div class="feature-with-large-image">
			<div class="feature-with-large-image__media">
				{{ media_image(fields.image, {size:'full', placeholder: true}) }}
			</div>
			<div class="feature-with-large-image__content">
				<h2>{{ fields.inset.title }}</h2>
				<div class="feature-with-large-image__text">{{ fields.inset.content }}</div>
				<div class="iastate22-button-set">
					<ul>
						<li>
							<a class="iastate22-button" href="{{ is_preview ? '#' : fields.inset.link.url['url']|e('esc_url') }}"
									{%- if not is_preview and fields.inset.link.url['target'] == "_blank" %} target="_blank"{%- endif -%}>
								{{ fields.inset.link.label }}<span class="arrow"></span></a>
						</li>
					</ul>
				</div>
			</div>
		</div>
	</div>
</div>
