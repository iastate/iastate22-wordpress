<div class="paragraph-widget paragraph-widget--image-grid-with-text"
		{%- if block.anchor|length > 0 %} id="{{ block.anchor|e('esc_attr') }}"{%- endif -%}>
	<div class="image-grid-with-text">
		<div class="image-grid-with-text__content text-content">
			{% if fields.image_grid_with_text.grid_content.title %}
				<h2>{{ fields.image_grid_with_text.grid_content.title|e('esc_html') }}</h2>{% endif %}
			{% if fields.image_grid_with_text.grid_content.content %}
				<div>{{ fields.image_grid_with_text.grid_content.content }}</div>{% endif %}
			{% if fields.image_grid_with_text.grid_content.link_url %}
				<div class="iastate22-button-set">
					<ul>
						<li>
							<a class="iastate22-button"
								 href="{{ is_preview ? '#' : fields.image_grid_with_text.grid_content.link_url|e('esc_url') }}"
									{%- if not is_preview and fields.image_grid_with_text.grid_content.external == true %} target="_blank"{%- endif -%}>
								{{ fields.image_grid_with_text.grid_content.label }}
								<span class="arrow"></span></a>
						</li>
					</ul>
				</div>
			{% endif %}
		</div>
		<div class="image-grid">
			{% if fields.image_grid_with_text.image_grid.main_image.url %}
				<div class="image-grid__image">
					{{ media_image(fields.image_grid_with_text.image_grid.main_image, {size:'large'}) }}
				</div>
			{% endif %}
			{% if fields.image_grid_with_text.image_grid.left_image.url %}
				<div class="image-grid__image">
					{{ media_image(fields.image_grid_with_text.image_grid.left_image, {size:'medium'}) }}
				</div>
			{% endif %}
			{% if fields.image_grid_with_text.image_grid.right_image.url %}
				<div class="image-grid__image">
					{{ media_image(fields.image_grid_with_text.image_grid.right_image, {size:'medium'}) }}
				</div>
			{% endif %}
			{% if fields.image_grid_with_text.image_grid.image_caption %}
				<div class="image-grid__caption">
					{{ fields.image_grid_with_text.image_grid.image_caption }}
				</div>
			{% endif %}
		</div>
	</div>
</div>
