<div class="paragraph-widget paragraph-widget--full-width-image"
		{%- if block.anchor|length > 0 %} id="{{ block.anchor|e('esc_attr') }}"{%- endif -%}>
	<figure class="full-width-image">
		{% if fields.image.url %}
			{{ media_image(fields.image, {size:'full'}) }}
		{% endif %}
		{% if fields.image_caption_toggle == true %}
			<figcaption class="full-width-image__caption text-content"
			>{{ fields.image_caption }}</figcaption>
		{% endif %}
	</figure>
</div>
