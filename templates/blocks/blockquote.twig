<div class="paragraph-widget paragraph-widget--blockquote"
		{%- if block.anchor|length > 0 %} id="{{ block.anchor|e('esc_attr') }}"{%- endif -%}>
	<div class="iastate22-blockquote
		{%- if fields.blockquote_image %} iastate22-blockquote--with-image{%- else %} iastate22-blockquote--with-no-image{%- endif -%}
		{%- if not fields.blockquote_copy.attribution %} iastate22-blockquote--no-author{%- endif -%}">
		<div class="iastate22-blockquote__inner-wrap">
			{% if fields.blockquote_image %}
				<div class="iastate22-blockquote__portrait">
					{{ media_image(fields.blockquote_image, {size:'medium'}) }}
				</div>
			{% endif %}
			<div class="iastate22-blockquote__text-wrap">
				{% if fields.blockquote_copy.quote %}
					<h2 class="iastate22-blockquote__quote">{{ fields.blockquote_copy.quote }}</h2>
				{% endif %}
				{% if fields.blockquote_copy.attribution %}
					<p class="iastate22-blockquote__author">{{ fields.blockquote_copy.attribution }}</p>
				{% endif %}
			</div>
		</div>
	</div>
</div>
