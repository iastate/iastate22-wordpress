{% set id = random(1111,9999) %}
<div
	class="paragraph-widget paragraph-widget--accordion"{% if block.anchor|length > 0 %} id="{{ block.anchor|e('esc_attr') }}"{% endif %}>
	<div class="accordion accordion-flush" id="accordionFlush{{ id }}">
		{% set counter = 0 %}
		{% for section in fields.accordion %}
			{% set counter = counter + 1 %}
			<div class="accordion-item">
				<h2 class="accordion-header" id="flush-heading{{ id }}-{{ counter }}">
					<button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
									data-bs-target="#flush-collapse{{ id }}-{{ counter }}" aria-expanded="false"
									aria-controls="flush-collapse{{ id }}-{{ counter }}">
						{{ section.title }}
					</button>
				</h2>
				<div id="flush-collapse{{ id }}-{{ counter }}" class="accordion-collapse collapse"
						 aria-labelledby="flush-heading{{ id }}-{{ counter }}" data-bs-parent="#accordionFlush{{ id }}">
					<div class="accordion-body text-content">{{ section.content }}</div>
				</div>
			</div>
		{% endfor %}
	</div>
</div>
