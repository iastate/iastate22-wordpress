{% if function('is_singular') or is_preview %}
  <div class="hero"
      {%- if block.anchor|length > 0 %} id="{{ block.anchor|e('esc_attr') }}"{%- endif -%}>
    <div class="hero__text-wrap">
      {% include ['templates/partial/breadcrumbs.twig'] %}
      <h1 class="hero__title">
        {% if fields.hero_title %}
          {{ fields.hero_title }}
        {% else %}
          {{ function('get_the_title') }}
        {% endif %}
      </h1>
    </div>
    {% if fields.hero_image %}
      <div class="hero__media">
        <img src="{{ fields.hero_image.url|e('esc_url') }}" alt="{{ fields.hero_image.alt|e('esc_attr') }}"
             width="{{ fields.hero_image.width|e('esc_attr') }}" loading="eager"
             height="{{ fields.hero_image.height|e('esc_attr') }}">
      </div>
    {% endif %}
    {% if fields.subnav_toggle == true -%}
      <div class="hero__subnav-wrap">
        {% include ['templates/partial/subnav.twig'] %}
      </div>
    {%- endif %}
  </div>
{% endif %}


