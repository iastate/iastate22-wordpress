<div class="paragraph-widget paragraph-widget--callout-with-image"
		{%- if block.anchor|length > 0 %} id="{{ block.anchor|e('esc_attr') }}"{%- endif -%}>
	<div class="callout-with-image">
		<div class="callout-with-image__media">
			{{ media_image(fields.callout_with_image.callout_image, {size:'full', placeholder: true}) }}
		</div>
		<div class="callout-with-image__content text-content">
			{% if fields.callout_with_image.callout_content.title %}
				<h2>{{ fields.callout_with_image.callout_content.title }}</h2>
			{% endif %}
			<div>{{ fields.callout_with_image.callout_content.content }}</div>
			{% if fields.callout_with_image.callout_content.callout_ctas %}
				<div class="link-set">
					<ul>
						{% for item in fields.callout_with_image.callout_content.callout_ctas -%}
							{%- if item.link_url|length > 0 %}
								{%- set link_url = item.link_url['url'] -%}
								{%- set link_target = item.link_url['target'] ? item.link_url['target'] : '_self' -%}
								<li>
									{%- if item.link_style == "button" -%}
										{%- set link_class = "link-set__link iastate22-button" -%}
									{%- elseif item.link_style == "standard" -%}
										{%- set link_class = "link-set__link iastate22-link-secondary" -%}
									{%- elseif item.link_style == "external" -%}
										{%- set link_class = "link-set__link iastate22-link-external" -%}
										{%- set link_target = "_blank" -%}
									{%- elseif item.link_style == "minimal" -%}
										{%- set link_class = "link-set__link link-tertiary" -%}
									{%- endif -%}
									<a class="{{ link_class|e('esc_attr') }}" href="{{ is_preview ? '#' : link_url|e('esc_url') }}"
									   target="{{ link_target|e('esc_attr') }}">
										{{ item.label }}
										<span class="arrow"></span>
									</a>
								</li>
							{% endif -%}
						{%- endfor %}
					</ul>
				</div>
			{% endif %}
		</div>
	</div>
</div>
