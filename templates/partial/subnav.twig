{% if is_preview -%}
  <nav class="subnav" aria-label="Sidebar">
    <button class="subnav__toggle" id="subnav-toggle" aria-controls="subnav-list" aria-haspopup="false"
            aria-expanded="false"><span>Subnavigation</span></button>
    <div class="subnav__list" id="subnav-list"></div>
  </nav>
{%- else -%}
  <nav class="subnav" aria-label="Sidebar">
    <noscript>
      <button class="subnav__toggle" id="subnav-toggle" aria-controls="subnav-list" aria-haspopup="true"
              aria-expanded="false"><span>Explore This Section</span></button>
    </noscript>
    <div class="subnav__list" id="subnav-list">
      <ul>
        <li>
          {% if sidenav.parent %}
            <a href="{{ function('get_permalink', sidenav.parent.ID ) }}">{{ sidenav.parent.title }}</a>
          {% else %}
            <a href="{{ site.url|e('esc_url') }}">Home</a>
          {% endif %}
        </li>
        {% if subnav_side_menu %}
          {% for link in subnav_side_menu.items %}
            <li>
              <a href="{{ link.url|e('esc_url') }}">{{ link.title }}</a>
              {% if link.children|length > 0 %}
                <ul>
                  {% for child in link.children %}
                    <li>
                      <a href="{{ child.url|e('esc_url') }}">{{ child.title }}</a>
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
            </li>
          {% endfor %}
        {% else %}
          {%- for post_sibling in sidenav.siblings %}
            {%- set menu_post = Post(post_sibling.ID) -%}
            {%- if menu_post.meta("hide_from_sidebar") != true %}
              <li>
                {%- if post_sibling %}
                  <a href="{{ menu_post.link }}"{% if menu_post.ID == sidenav.current %} aria-current="page"{% endif %}>{{ menu_post.post_title }}</a>
                {% else %}
                  <span class="lw_separator_title"></span>
                {% endif -%}
                {%- if menu_post.ID == sidenav.current and sidenav.children|length > 0 %}
                  <ul>
                    {% for post_child in sidenav.children %}
                      {%- set sub_menu_post = Post(post_child.ID) -%}
                      {% if sub_menu_post.meta("hide_from_sidebar") != true %}
                        <li>
                          <a href="{{ sub_menu_post.link }}">{{ sub_menu_post.post_title }}</a>
                        </li>
                      {% endif %}
                    {% endfor %}
                  </ul>
                {% endif -%}
              </li>
            {% endif %}
          {% endfor -%}
        {% endif %}
      </ul>
    </div>
  </nav>
{%- endif %}