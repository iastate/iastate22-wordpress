{% if posts|length %}
	<div class="paragraph-widget paragraph-widget--faculty-staff-card-set">
		<div class="faculty-staff-card-set">
			{% for post in posts %}
				{% set firstName = post.meta('first_name') %}
				{% set lastName = post.meta('last_name') %}
				{% set photo = post.meta('photo') %}
				{% set titles = post.meta('titles') %}
				{% set profileLinks = post.meta('profile_links') %}
				{% set email = post.meta('email') %}
				{% set phone = post.meta('phone') %}
				{% set address = post.meta('address') %}
				{% set social_networks = post.meta('social_networks') %}
				{% set biography = post.meta('bio') %}
				{% set resume = post.meta('resume') %}
				{% set degrees = post.meta('degrees') %}
				{% set affiliations = post.meta('affiliations') %}
				{% set publications = post.meta('publication') %}
				{% if biography|length > 96 %}
					{% set biography = biography|truncate(96) ~ ' ... ' %}
				{% endif %}

				<div>
					<div class="faculty-staff-card">
						<div class="faculty-staff-card__media">
							{% if Image(post._thumbnail_id) %}
								{% set thumb = Image(post._thumbnail_id) %}
							{% endif %}
							{% if Image(post._thumbnail_id).src %}
								<div class="faculty-staff-card__media-container">
									<img class="faculty-staff-card__media-image" src="{{ thumb.src|e('esc_url') }}"
										 alt="{{ thumb.alt|e('esc_attr') }}" loading="lazy">
								</div>
							{% elseif photo != null %}
								<div class="faculty-staff-card__media-container">
									<img class="faculty-staff-card__media-image" src="{{ photo.url|e('esc_url') }}"
										 alt="{{ photo.alt|e('esc_attr') }}" loading="lazy">
								</div>
							{% endif %}
						</div>
						<div class="faculty-staff-card__content">
							<h3 class="faculty-staff-card__content-name">{{ firstName }} {{ lastName }}</h3>
							{% if titles|length > 0 %}
								<div class="faculty-staff-feed-item__content-body">
									{% for i, title in titles %}
										{{ title.title }}{% if i < titles|length - 1 %},<br> {% endif %}
									{% endfor %}
								</div>
							{% endif %}
							<p>
								<a href="{{ post.link|e('esc_url') }}" class="iastate22-link-secondary">About <span
										class="arrow"></span></a>
							</p>
							<ul class="faculty-staff-card__content-contact">
								{% if email|length > 0 %}
									<li>
										<div class="faculty-staff-card__content-icon"><a href="mailto:{{ email }}" aria-label="email">
												<i class="fak fa-iastate22-email" role="img"></i></a>
										</div>
										<div class="faculty-staff-card__contact-field"><a href="mailto:{{ email }}">{{ email }}</a></div>
									</li>
								{% endif %}
								{% if phone|length > 0 %}
									<li>
										<div class="faculty-staff-card__content-icon">
											<i class="fak fa-iastate22-phone" aria-label="phone" role="img"></i>
										</div>
										<div class="faculty-staff-card__contact-field">{{ phone }}</div>
									</li>
								{% endif %}
								{# <li>
                            <div class="faculty-staff-card__content-key"><strong>Name:</strong></div>
                            <div class="faculty-staff-card__contact-value">Lorem ipsum</div>
                        </li>
                        <li>
                            <div class="faculty-staff-card__content-key"><strong>Name2:</strong></div>
                            <div class="faculty-staff-card__contact-value"><a href="#">Lorem ipsum</a></div>
                        </li>
                        <li>
                            <div class="faculty-staff-card__content-key"><strong>Name3:</strong></div>
                            <div class="faculty-staff-card__contact-value"><a href="#">Lorem ipsum</a></div>
                        </li>
                        <li>
                            <div class="faculty-staff-card__content-key"><strong>Name4:</strong></div>
                            <div class="faculty-staff-card__contact-value">Lorem ipsum</div>
                        </li> #}
								{# Degrees, Affiliations, Publications and Resume are presumed, but this area isn't well defined. #}
							</ul>
						</div>
					</div>
				</div>
			{% endfor %}
		</div>
	</div>
{% endif %}
